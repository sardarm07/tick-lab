{
  "uid": "ticklab-correctness",
  "title": "Correctness",
  "tags": [
    "ticklab"
  ],
  "description": "Our 1-minute candles against the exchanges' official candles, minute by minute.",
  "timezone": "utc",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Exact matches, last hour",
      "description": "Settled minutes whose candle equals the exchange's in every field.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.22.1",
          "rawSql": "SELECT countIf(status = 'MATCH') / count() AS exact\nFROM ticklab.reconciliation FINAL\nWHERE minute >= now() - INTERVAL 1 HOUR"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Exact matches, last 24 hours",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.22.1",
          "rawSql": "SELECT countIf(status = 'MATCH') / count() AS exact\nFROM ticklab.reconciliation FINAL\nWHERE minute >= now() - INTERVAL 24 HOUR"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Minutes checked, last 24 hours",
      "description": "Per pair, a minute is checked once it has settled.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.22.1",
          "rawSql": "SELECT count() FROM ticklab.reconciliation FINAL WHERE minute >= now() - INTERVAL 24 HOUR"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Unexplained mismatches, last 24 hours",
      "description": "Mismatches with no known cause. Should be 0.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.22.1",
          "rawSql": "SELECT countIf(status = 'MISMATCH' AND cause IN ('', 'unknown'))\nFROM ticklab.reconciliation FINAL WHERE minute >= now() - INTERVAL 24 HOUR"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Checked minutes by result",
      "description": "Each settled minute of each pair, by result; mismatches by cause.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "pluginVersion": "4.22.1",
          "rawSql": "SELECT\n    $__timeInterval(minute) AS time,\n    if(status = 'MATCH', 'match', concat('mismatch: ', cause)) AS result,\n    count() AS minutes\nFROM ticklab.reconciliation FINAL\nWHERE $__timeFilter(minute)\nGROUP BY time, result\nORDER BY time"
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Mismatches",
      "description": "Field: ours / the exchange's. Attempt 2 is the re-check, 10 minutes after the minute ends.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.22.1",
          "rawSql": "SELECT minute, exchange, symbol, cause, differences, attempt, checked_at\nFROM ticklab.reconciliation FINAL\nWHERE status = 'MISMATCH' AND $__timeFilter(minute)\nORDER BY minute DESC\nLIMIT 500"
        }
      ]
    }
  ]
}
