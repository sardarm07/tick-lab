{
  "uid": "ticklab-pipeline",
  "title": "Pipeline",
  "tags": [
    "ticklab"
  ],
  "description": "How fast data moves through the pipeline, and what it costs.",
  "timezone": "utc",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Trades published per second",
      "description": "Trades the producers normalised and sent to Kafka, by exchange.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (exchange) (rate(ticklab_trades_total[$__rate_interval]))",
          "legendFormat": "{{exchange}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Trades read per second, by Flink job",
      "description": "Records the Kafka source of each job emits. Both jobs read every trade.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (job_name) (flink_taskmanager_job_task_operator_numRecordsOutPerSecond{operator_name=\"Source:_trades\"})",
          "legendFormat": "{{job_name}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Consumer lag",
      "description": "Trades in Kafka that a job's source hasn't read yet (pendingRecords). A job that keeps up stays near zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (job_name) (flink_taskmanager_job_task_operator_pendingRecords)",
          "legendFormat": "{{job_name}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Busy time, busiest task of each job",
      "description": "Milliseconds per second the busiest task spent working: 1,000 means saturated.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (job_name) (flink_taskmanager_job_task_busyTimeMsPerSecond)",
          "legendFormat": "{{job_name}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Checkpoint duration",
      "description": "How long the latest checkpoint of each job took, from trigger to completion.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "flink_jobmanager_job_lastCheckpointDuration",
          "legendFormat": "{{job_name}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Checkpoint size",
      "description": "Full size of the latest checkpoint of each job: the state it holds.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "flink_jobmanager_job_lastCheckpointFullSize",
          "legendFormat": "{{job_name}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Feed latency",
      "description": "Received by the producer minus the exchange's trade time, live WebSocket trades only. It includes the offset between the exchange's clock and ours, so it can be negative.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "pluginVersion": "4.22.1",
          "rawSql": "SELECT $__timeInterval(trade_time) AS time,\n       quantileExact(0.5)(ms) AS p50, quantileExact(0.95)(ms) AS p95,\n       quantileExact(0.99)(ms) AS p99\nFROM (SELECT trade_time, (toUnixTimestamp64Micro(received_time) - toUnixTimestamp64Micro(trade_time)) / 1000 AS ms FROM ticklab.trades\n      WHERE $__timeFilter(trade_time) AND source = 'WS')\nGROUP BY time ORDER BY time"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Pipeline latency",
      "description": "Stored in ClickHouse minus published to Kafka, per trade. ClickHouse reads Kafka in blocks (every 5 s at most), which dominates it. Our clocks only.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "pluginVersion": "4.22.1",
          "rawSql": "SELECT $__timeInterval(published_at) AS time,\n       quantileExact(0.5)(ms) AS p50, quantileExact(0.95)(ms) AS p95,\n       quantileExact(0.99)(ms) AS p99\nFROM (SELECT published_at, toUnixTimestamp64Milli(inserted_at) - toUnixTimestamp64Milli(published_at) AS ms FROM ticklab.trades\n      WHERE $__timeFilter(published_at))\nGROUP BY time ORDER BY time"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Output latency of candles",
      "description": "Emitted by Flink minus the publishing of the newest trade in the candle. A candle is emitted once the watermark passes its end. Our clocks only.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "pluginVersion": "4.22.1",
          "rawSql": "SELECT $__timeInterval(emitted_at) AS time,\n       quantileExact(0.5)(ms) AS p50, quantileExact(0.95)(ms) AS p95,\n       quantileExact(0.99)(ms) AS p99\nFROM (SELECT emitted_at, toUnixTimestamp64Milli(emitted_at) - toUnixTimestamp64Milli(input_published_at) AS ms FROM ticklab.candles\n      WHERE $__timeFilter(emitted_at))\nGROUP BY time ORDER BY time"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
