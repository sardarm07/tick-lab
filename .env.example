# Tick Lab settings. `make` copies this file to .env when .env doesn't exist.
# Nothing here is secret: the exchange endpoints are public, and the local services
# listen on 127.0.0.1 only.

# Logins for the local services
CLICKHOUSE_USER=ticklab
CLICKHOUSE_PASSWORD=ticklab
GRAFANA_ADMIN_PASSWORD=admin

# Binance. wss://data-stream.binance.vision serves the same market data.
BINANCE_WS_URL=wss://stream.binance.com:9443
# Replace each connection after this many seconds; Binance closes them after 24 hours.
BINANCE_MAX_CONNECTION_AGE_S=82800
# Replace a connection that has delivered nothing for this many seconds.
FEED_STALE_AFTER_S=60
