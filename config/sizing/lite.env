# Memory limits for the lite profile: a machine with 8 GB of RAM (a 2-core codespace).
# Every service gets a hard limit; `make check-m1` reports what each one actually uses.
REDPANDA_MEMORY=600M
REDPANDA_MEM_LIMIT=1000m
CLICKHOUSE_MEM_LIMIT=800m
PROMETHEUS_MEM_LIMIT=200m
GRAFANA_MEM_LIMIT=400m
PRODUCER_MEM_LIMIT=100m
FLINK_JM_PROCESS=700m
FLINK_JM_MEM_LIMIT=740m
# The JobManager loads each submitted job's jar, and the signals job's SQL planner, into its
# metaspace: 163 MiB measured with all three jobs, after a drain (milestone 6).
FLINK_JM_METASPACE=256m
FLINK_TM_PROCESS=1200m
FLINK_TM_MEM_LIMIT=1300m
# 111 MiB measured with all three jobs running.
FLINK_TM_METASPACE=192m
# One slot per job (core, signals, analyses): jobs on a session cluster never share slots.
FLINK_TM_SLOTS=3
# Managed memory, split evenly between the slots: Flink SQL's window aggregations (the signals
# job) buffer rows in it. 32 MB a slot, as in milestones 4 and 5.
FLINK_TM_MANAGED=96m
FLINK_PARALLELISM=1
RECONCILER_MEM_LIMIT=100m
GAP_REPAIR_MEM_LIMIT=100m
